    # HuggingFace
    hf_token: Optional[str] = Field(default=None)

    # Performance
    num_loader_threads: int = Field(default=4)
    pe_core_batch_size: int = Field(default=32)
    preload_visual_features: bool = Field(default=False)

    def resolve_path(self, path: Path) -> Path:
        """Resolve a path, expanding ${DATA_ROOT} and relative paths."""
        path_str = str(path)
        if path_str.startswith("${DATA_ROOT}"):
            path_str = path_str.replace("${DATA_ROOT}", str(self.data_root))
        resolved = Path(path_str)
        # On Windows, ``\rooted`` has a root but no drive. Preserve it instead
        # of silently rebasing it to the current drive/directory.
        if not resolved.is_absolute() and not resolved.root:
            resolved = Path.cwd() / resolved
        return resolved


@lru_cache
def get_settings() -> Settings:
    """Get cached settings singleton."""
    return Settings()
