    def load_pe_core_encoder(self):
        """Load the canonical PE-Core visual/text encoder lazily."""
        if self._pe_core_encoder is None:
            with self._resource_lock:
                if self._pe_core_encoder is None:
                    from src.encoders import PECoreEncoder

                    logger.info(
                        f"Loading PE-Core encoder: {self._settings.pe_core_model_id}"
                    )
                    self._pe_core_encoder = PECoreEncoder(
                        model_id=self._settings.pe_core_model_id,
                        device=self._pe_core_device,
                    )
        return self._pe_core_encoder

    # ????????? Raw embedding reconstruction (for embedding-based rerank) ??????????????????????????????

    def get_pe_core_vector(self, frame_id_str: str) -> Optional[np.ndarray]:
        """Fetch one candidate's raw PE-Core vector by its frame_ids.json key.

        Cheap: the visual FAISS index is IndexFlatIP (exact, stores vectors
        verbatim ??? see scripts/build_index.py), so reconstruct() is a plain
        row lookup, not a search. Returns None when the index isn't loaded
        or the frame isn't in it, so callers can fall back gracefully.
        """
        index = self.load_visual_index()
        if index is None:
            return None
        if isinstance(index, QdrantVisualIndex):
            # The Final_AIC Qdrant adapter is intentionally search-only.
            # Remote vector reconstruction is not required by the normal RRF
            # path and would add a large, avoidable network round-trip.
            return None
        if self._pe_core_frame_row_lookup is None:
            frame_ids = self.load_frame_ids()
            self._pe_core_frame_row_lookup = {fid: i for i, fid in enumerate(frame_ids)}
        row = self._pe_core_frame_row_lookup.get(frame_id_str)
        if row is None:
            return None
        return np.asarray(index.reconstruct(int(row)), dtype=np.float32)

    def get_beit3_vector(self, frame_id_str: str) -> Optional[np.ndarray]:
        """Fetch one candidate's raw BEiT-3 vector by its frame_ids key.

        Mirrors get_pe_core_vector for the ensemble's second granularity.
        """
        loaded = self.load_beit3_visual_index()
        if loaded is None:
            return None
        index, beit3_frame_ids = loaded
        if isinstance(index, QdrantVisualIndex):
            return None
        if self._beit3_frame_row_lookup is None:
            self._beit3_frame_row_lookup = {
                fid: i for i, fid in enumerate(beit3_frame_ids)
            }
        row = self._beit3_frame_row_lookup.get(frame_id_str)
        if row is None:
            return None
        return np.asarray(index.reconstruct(int(row)), dtype=np.float32)

