    def load_catalog(self):
        """Open the deployed catalog once, read-only and immutable.

        A missing catalog means the compatibility JSON deployment is still in
        use. A catalog that exists but has an invalid schema fails loudly; it
        is never silently treated as legacy data.
        """

        if not self._catalog_checked:
            with self._resource_lock:
                if not self._catalog_checked:
                    from src.storage.catalog import Catalog

                    path = self._settings.resolve_path(self._settings.catalog_path)
                    if not path.is_file():
                        self._catalog_checked = True
                        logger.info(
                            f"SQLite catalog not found at {path}; using compatibility sidecars"
                        )
                        return None
                    if getattr(self._settings, "catalog_require_tmpfs", False):
                        resolved = path.resolve()
                        try:
                            resolved.relative_to(Path("/dev/shm"))
                        except ValueError as exc:
                            raise ValueError(
                                "UIT runtime catalog must be staged under /dev/shm "
                                "when CATALOG_REQUIRE_TMPFS=true"
                            ) from exc
                    catalog = Catalog(path, read_only=True, immutable=True)
                    try:
                        catalog.validate_schema()
                    except Exception:
                        catalog.close()
                        raise
                    self._catalog = catalog
                    self._catalog_checked = True
                    logger.info(f"Opened immutable SQLite catalog from {path}")
        return self._catalog

    def _active_catalog_index(
        self, alias: str
    ) -> Optional[Mapping[str, object]]:
        if alias in self._catalog_index_records:
            return self._catalog_index_records[alias]
        catalog = self.load_catalog()
        record = None if catalog is None else catalog.get_active_frame_index(alias)
        self._catalog_index_records[alias] = record
        return record

    def _catalog_visual_mode(self) -> bool:
        return self._active_catalog_index(self._settings.pe_core_index_alias) is not None

    def _catalog_frame_contract(
        self, record: Mapping[str, object]
    ) -> Tuple[List[str], Dict[str, Dict[str, object]]]:
        frame_ids: List[str] = []
        mapping: Dict[str, Dict[str, object]] = {}
        for row in record["rows"]:
            frame_uid = str(row["frame_uid"])
            fps = float(row["fps_num"]) / float(row["fps_den"])
            metadata = {
                "video_id": row["video_id"],
                "frame_number": int(row["original_frame_idx"]),
                "video_uid": row["video_uid"],
                "candidate_idx": int(row["candidate_idx"]),
                "timestamp_us": int(row["timestamp_us"]),
                "fps": fps,
            }
            previous = self._catalog_frame_mapping.get(frame_uid)
            if previous is not None and previous != metadata:
                raise ValueError(f"catalog frame_uid {frame_uid} has conflicting metadata")
            frame_ids.append(frame_uid)
            mapping[frame_uid] = metadata
            self._catalog_frame_mapping[frame_uid] = metadata
            self._catalog_video_fps[str(row["video_id"])] = fps
        return frame_ids, mapping

    def _load_catalog_faiss_index(
        self,
        record: Mapping[str, object],
        *,
        expected_modality: str,
        expected_model_id: str,
    ) -> faiss.Index:
        """Validate catalog provenance/checksum and load one immutable FAISS file."""

        from src.data.frame_manifest import sha256_file
        from src.storage.catalog import resolve_data_root_uri

        if record["backend"] != "faiss":
            raise ValueError(f"catalog index backend must be faiss, got {record['backend']!r}")
        if record["modality"] != expected_modality:
            raise ValueError(
                f"catalog index modality is {record['modality']!r}, expected "
                f"{expected_modality!r}"
            )
        if record["metric"] != "inner_product" or not record["normalized"]:
            raise ValueError("visual catalog index must use normalized inner-product vectors")
        if record["model_id"] != expected_model_id:
            raise ValueError(
                f"catalog index was built with model '{record['model_id']}' but "
                f"runtime expects '{expected_model_id}'"
            )

        path = resolve_data_root_uri(
            self._settings.resolve_path(self._settings.data_root),
            str(record["index_uri"]),
        )
        if not path.is_file():
            raise FileNotFoundError(f"catalog FAISS artifact not found at {path}")
        if (
            getattr(self._settings, "catalog_verify_artifact_checksums", True)
            and path not in self._verified_catalog_artifacts
        ):
            actual_checksum = sha256_file(path)
            if actual_checksum != record["index_sha256"]:
                raise ValueError(
                    f"catalog FAISS checksum mismatch for {path}: "
                    f"expected {record['index_sha256']}, got {actual_checksum}"
                )
            self._verified_catalog_artifacts.add(path)

        index = faiss.read_index(str(path))
        if index.ntotal != int(record["row_count"]):
            raise ValueError(
                f"FAISS ntotal={index.ntotal} differs from catalog row_count="
                f"{record['row_count']}"
            )
        if index.d != int(record["dimension"]):
            raise ValueError(
                f"FAISS dimension={index.d} differs from catalog dimension="
                f"{record['dimension']}"
            )
        metric_type = getattr(index, "metric_type", None)
        if metric_type is not None and metric_type != faiss.METRIC_INNER_PRODUCT:
            raise ValueError("FAISS metric does not match catalog inner_product metadata")
        return index

    def load_audio_index(self) -> faiss.Index:
        """Load FAISS audio index lazily."""
        if self._audio_index is None:
            with self._resource_lock:
                if self._audio_index is None:
                    path = self._settings.audio_faiss_index_path
                    if not path.exists():
                        raise FileNotFoundError(
                            f"Audio FAISS index not found at {path}. "
                            "Run scripts/build_index.py first."
                        )
                    logger.info(f"Loading audio FAISS index from {path}")
                    self._audio_index = faiss.read_index(str(path))
                    logger.info(
                        f"Audio FAISS index loaded: {self._audio_index.ntotal} vectors, "
                        f"dim={self._audio_index.d}"
                    )
        return self._audio_index

    def load_asr_bge_index(self) -> Optional[faiss.Index]:
        """Load the semantic ASR (BGE-M3, 20s segments) FAISS index lazily.

        Returns None (not raise) when unconfigured or the file is missing ???
        this is an optional refinement over the coarser one-vector-per-video
        audio index above, not a required resource.
        """
        if self._asr_bge_index is None:
            with self._resource_lock:
                if self._asr_bge_index is None:
                    path = self._settings.asr_bge_index_path
                    if path is None or not path.exists():
                        return None
                    logger.info(f"Loading ASR BGE-M3 FAISS index from {path}")
                    self._asr_bge_index = faiss.read_index(str(path))
                    logger.info(
                        f"ASR BGE-M3 FAISS index loaded: "
                        f"{self._asr_bge_index.ntotal} segments, dim={self._asr_bge_index.d}"
                    )
        return self._asr_bge_index

    def load_asr_bge_segments(self) -> List[Dict]:
        """Load the row-ordered ASR segment sidecar (video_id/start/end/text)."""
        if self._asr_bge_segments is None:
            path = self._settings.asr_bge_segments_path
            if path is None or not path.exists():
                self._asr_bge_segments = []
            else:
                with open(path, "r", encoding="utf-8") as f:
                    self._asr_bge_segments = json.load(f)
                logger.info(
                    f"ASR BGE-M3 segments loaded: {len(self._asr_bge_segments)} entries"
                )
        return self._asr_bge_segments

