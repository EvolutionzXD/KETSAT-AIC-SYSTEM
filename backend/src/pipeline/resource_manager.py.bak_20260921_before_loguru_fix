    def get_jina_v5_vector(self, frame_id_str: str) -> Optional[np.ndarray]:
        """Fetch one Jina v5 vector by frame-id key for optional reranking."""
        loaded = self.load_jina_v5_visual_index()
        if loaded is None:
            return None
        index, frame_ids = loaded
        if isinstance(index, QdrantVisualIndex):
            return None
        if self._jina_v5_frame_row_lookup is None:
            self._jina_v5_frame_row_lookup = {
                fid: i for i, fid in enumerate(frame_ids)
            }
        row = self._jina_v5_frame_row_lookup.get(str(frame_id_str))
        if row is None:
            return None
        return np.asarray(index.reconstruct(int(row)), dtype=np.float32)

