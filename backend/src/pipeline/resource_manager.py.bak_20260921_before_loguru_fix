    def get_video_fps(self, video_id: str) -> float:
        """Return native FPS from the catalog, then legacy video metadata.

        Falls back to :data:`DEFAULT_FPS` with a one-time warning per video
        when the metadata is missing or invalid.
        """
        catalog_fps = getattr(self, "_catalog_video_fps", {})
        if video_id not in catalog_fps and hasattr(self, "_settings"):
            record = self._active_catalog_index(
                self._settings.pe_core_index_alias
            )
            if record is not None:
                self._catalog_frame_contract(record)
                catalog_fps = self._catalog_video_fps
        if video_id in catalog_fps:
            return catalog_fps[video_id]
        metadata = self.load_video_metadata()
        fps = metadata.get(video_id, {}).get("fps")
        if isinstance(fps, (int, float)) and fps > 0:
            return float(fps)
        if video_id not in self._fps_warned:
            self._fps_warned.add(video_id)
            logger.warning(
                f"No FPS metadata for video '{video_id}'; falling back to "
                f"{DEFAULT_FPS}. Frame/time conversions may be wrong ??? "
                "rebuild video_metadata.json with scripts/build_frame_mapping.py"
            )
        return DEFAULT_FPS

    def get_frame_path(self, video_id: str, frame_id: int):
        """Resolve batch1 JPEG through its video manifest."""
        if not hasattr(self, "_frame_manifest_index"):
            self._frame_manifest_index = None
        if self._frame_manifest_index is None:
            configured_root = self._settings.frame_candidates_root
            root = Path(configured_root) if configured_root else None
            manifests = root / "manifests" if root is not None else None
            index = {}
            if manifests is not None and manifests.exists():
                for mp in manifests.glob("*.json"):
                    try:
                        with open(mp, "r", encoding="utf-8") as f:
                            d = json.load(f)
                        vid = d.get("video_id")
                        rel = d.get("candidate_frame_dir")
                        if vid and rel:
                            index[str(vid)] = root / rel
                    except (OSError, json.JSONDecodeError):
                        continue
            self._frame_manifest_index = index
        frame_dir = self._frame_manifest_index.get(str(video_id))
        if frame_dir is None:
            return None
        path = frame_dir / f"{int(frame_id):08d}.jpg"
        if path.exists():
            return path
        # Retrieval sources such as OCR/ASR may point at an arbitrary source
        # frame while batch1 JPEGs are sampled on a 5-frame grid. Resolve the
        # nearest available keyframe for display/reranking; callers retain the
        # original frame_id for submission.
        requested = int(frame_id)
        for distance in range(1, 6):
            for nearby in (requested - distance, requested + distance):
                if nearby < 0:
                    continue
                candidate = frame_dir / f"{nearby:08d}.jpg"
                if candidate.exists():
                    return candidate
        return None

