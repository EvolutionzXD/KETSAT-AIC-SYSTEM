    def _jina_v5_index_paths(self) -> Tuple[Optional[Path], Optional[Path]]:
        """Resolve exactly the configured Jina v5 view.

        ``build_jina_faiss.py`` writes ``reduce.index`` and
        ``reduce.frame_ids.json`` for the common-reduction view.  Explicit
        paths take precedence; a missing requested view never silently falls
        back from reduce to full.
        """
        index_path = getattr(self._settings, "jina_v5_visual_index_path", None)
        ids_path = getattr(self._settings, "jina_v5_frame_ids_path", None)
        index_dir = getattr(self._settings, "jina_v5_visual_index_dir", None)
        view = getattr(self._settings, "jina_v5_visual_view", "reduce")

        if index_path is not None:
            index_path = self._settings.resolve_path(Path(index_path))
            if ids_path is None:
                ids_path = index_path.with_name(
                    index_path.stem + ".frame_ids.json"
                )
        elif index_dir is not None:
            index_dir = self._settings.resolve_path(Path(index_dir))
            candidates = (
                (index_dir / f"{view}.index", index_dir / f"{view}.frame_ids.json"),
                (index_dir / f"{view}.faiss", index_dir / f"{view}.frame_ids.json"),
            )
            for candidate_index, candidate_ids in candidates:
                if candidate_index.is_file() and candidate_ids.is_file():
                    index_path, ids_path = candidate_index, candidate_ids
                    break
        if ids_path is not None:
            ids_path = self._settings.resolve_path(Path(ids_path))
        return index_path, ids_path

    def load_jina_v5_visual_index(
        self,
    ) -> Optional[Tuple[faiss.Index, List[str]]]:
        """Load the optional Jina v5 visual index and its row sidecar.

        The Jina builder emits a small ``*.meta.json`` provenance file rather
        than the catalog's ``index_metadata.json``.  Validate the row count,
        dimension and IP metric here so a stale/full sidecar cannot corrupt
        fusion.  A missing optional artifact disables only this lane.
        """
        if self._jina_v5_visual_index is not None:
            return self._jina_v5_visual_index, self._jina_v5_frame_ids
        if (
            getattr(self._settings, "visual_index_backend", "faiss") == "qdrant"
            and getattr(self._settings, "jina_v5_enabled", False)
        ):
            with self._resource_lock:
                if self._jina_v5_visual_index is None:
                    self._jina_v5_visual_index = self._load_qdrant_visual_index(
                        self._settings.qdrant_jina_v5_collection, 768
                    )
                    self._jina_v5_frame_ids = []
            return self._jina_v5_visual_index, self._jina_v5_frame_ids

        index_path, ids_path = self._jina_v5_index_paths()
        if index_path is None or ids_path is None:
            return None
        if not index_path.is_file() or not ids_path.is_file():
            logger.warning(
                "Jina v5 index/frame_ids not found: %s / %s; lane disabled",
                index_path,
                ids_path,
            )
            return None

        with self._resource_lock:
            if self._jina_v5_visual_index is not None:
                return self._jina_v5_visual_index, self._jina_v5_frame_ids

            logger.info("Loading Jina v5 visual index from %s", index_path)
            jina_index = faiss.read_index(str(index_path))
            with ids_path.open("r", encoding="utf-8") as handle:
                jina_frame_ids = json.load(handle)
            if not isinstance(jina_frame_ids, list) or not jina_frame_ids:
                raise ValueError("Jina v5 frame sidecar must be a non-empty list")
            jina_frame_ids = [str(value) for value in jina_frame_ids]
            if int(jina_index.ntotal) != len(jina_frame_ids):
                raise ValueError(
                    "Jina v5 index/frame sidecar mismatch: "
                    f"{jina_index.ntotal} != {len(jina_frame_ids)}"
                )
            metric_type = getattr(jina_index, "metric_type", None)
            if metric_type is not None and metric_type != faiss.METRIC_INNER_PRODUCT:
                raise ValueError(
                    "Jina v5 index must use inner-product metric; "
                    f"got {metric_type}"
                )

            # For reduce.index this resolves to reduce.meta.json.  Validate
            # when present, but keep the row contract sufficient for older
            # converted artifacts that have no metadata file.
            meta_path = index_path.with_suffix(".meta.json")
            if meta_path.is_file():
                try:
                    with meta_path.open("r", encoding="utf-8") as meta_file:
                        metadata = json.load(meta_file)
                    meta_dim = metadata.get("dimension")
                    if meta_dim is not None and int(meta_dim) != int(jina_index.d):
                        raise ValueError(
                            "Jina v5 metadata/index dimension mismatch: "
                            f"{meta_dim} != {jina_index.d}"
                        )
                    metric = str(metadata.get("metric", "IP")).upper()
                    if metric not in {"IP", "INNER_PRODUCT"}:
                        raise ValueError("Jina v5 metadata metric is not IP")
                except json.JSONDecodeError as exc:
                    raise ValueError(f"invalid Jina v5 metadata: {meta_path}") from exc

            self._jina_v5_visual_index = jina_index
            self._jina_v5_frame_ids = jina_frame_ids
            logger.info(
                "Jina v5 visual index loaded: %d vectors, dim=%d, view=%s",
                jina_index.ntotal,
                jina_index.d,
                getattr(self._settings, "jina_v5_visual_view", "reduce"),
            )
        return self._jina_v5_visual_index, self._jina_v5_frame_ids

