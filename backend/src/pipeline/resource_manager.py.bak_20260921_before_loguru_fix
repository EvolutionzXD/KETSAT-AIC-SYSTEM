#: Fallback when a video has no FPS metadata. Frame/time conversions using
#: this value are unreliable for videos recorded at another rate.
DEFAULT_FPS = 25.0


class ResourceManager:
    """
    Centralized resource loader with lazy initialization and thread-safe access.

    Loads on first access, then holds references for the entire process lifetime.
    This is critical for performance: avoids re-reading FAISS indexes and metadata
    on every single query.
    """

    _instance: Optional["ResourceManager"] = None
    _lock = threading.Lock()

    def __new__(cls) -> "ResourceManager":
        if cls._instance is None:
            with cls._lock:
                if cls._instance is None:
                    cls._instance = super().__new__(cls)
                    cls._instance._initialized = False
        return cls._instance

    def __init__(self):
        if self._initialized:
            return
        self._initialized = True
        self._settings = get_settings()
        self._device = torch.device(
            "cuda" if self._settings.device == "cuda" and torch.cuda.is_available() else "cpu"
        )
        self._pe_core_device = self._configured_device(
            self._settings.pe_core_device, self._device
        )
        self._siglip2_device = self._configured_device(
            self._settings.siglip2_device, self._device
        )
        default_beit3_device = self._device
        if self._device.type == "cuda" and torch.cuda.device_count() >= 2:
            default_beit3_device = torch.device("cuda:1")
        self._beit3_device = self._configured_device(
            self._settings.beit3_device, default_beit3_device
        )
        self._jina_v5_device = self._configured_device(
            getattr(self._settings, "jina_v5_device", None), self._device
        )
        logger.info(
            "Encoder devices: PE-Core={}, SigLIP2={}, BEiT-3={}, Jina-v5={}",
            self._pe_core_device,
            self._siglip2_device,
            self._beit3_device,
            self._jina_v5_device,
        )

        # Core resources (lazy loaded)
        self._audio_index: Optional[faiss.Index] = None
        self._visual_index: Optional[faiss.Index] = None
        self._audio_metadata: Optional[Dict] = None
        self._frame_ids: Optional[List] = None
        self._frame_mapping: Optional[Dict] = None
        self._video_metadata: Optional[Dict] = None
        self._catalog = None
        self._catalog_checked = False
        self._catalog_index_records: Dict[str, Optional[Mapping[str, object]]] = {}
        self._catalog_frame_mapping: Dict[str, Dict[str, object]] = {}
        self._catalog_video_fps: Dict[str, float] = {}
        self._verified_catalog_artifacts: set = set()

        self._ocr_results: Optional[Dict] = None
        self._ocr_frame_map = None
        self._ocr_semantic_index: Optional[faiss.Index] = None
        self._ocr_semantic_metadata: Optional[List[Dict]] = None
        self._ocr_semantic_load_attempted = False
        self._caption_results: Optional[Dict] = None
        self._qwen_structured_indexes = None
        self._scene_graph: Optional[Dict] = None
        self._visual_features: Optional[Dict[str, Tuple[np.ndarray, List[int]]]] = None
        self._asr_bge_index: Optional[faiss.Index] = None
        self._asr_bge_segments: Optional[List[Dict]] = None
        self._asr_bge_fine_index: Optional[faiss.Index] = None
        self._asr_bge_fine_segments: Optional[List[Dict]] = None

        # Models (lazy loaded)
        self._pe_core_encoder = None
        self._text_embed_model: Optional[AutoModel] = None
        self._text_embed_tokenizer: Optional[AutoTokenizer] = None
        self._beit3_encoder = None
        self._bge_m3_encoder = None
        self._pe_core_frame_row_lookup: Optional[Dict[str, int]] = None
        self._beit3_frame_row_lookup: Optional[Dict[str, int]] = None

        # Second granularity for the ensemble (Algorithm 3): BEiT-3 index +
        # its own frame_ids.json, self-contained per scripts/build_index.py.
        self._beit3_visual_index: Optional[faiss.Index] = None
        self._beit3_frame_ids: Optional[List[str]] = None

        # Third granularity: SigLIP2
        self._siglip2_encoder = None
        self._siglip2_visual_index: Optional[faiss.Index] = None
        self._siglip2_frame_ids: Optional[List[str]] = None
        # Optional Jina v5 Omni visual lane.  Its packed artifact uses the
        # explicit ``reduce.index``/``reduce.frame_ids.json`` convention and
        # is deliberately kept outside the catalog aliases.
        self._jina_v5_encoder = None
        self._jina_v5_visual_index: Optional[faiss.Index] = None
        self._jina_v5_frame_ids: Optional[List[str]] = None
        self._jina_v5_frame_row_lookup: Optional[Dict[str, int]] = None

        # Feature matrix for fast visual search
        self._visual_feature_matrix: Optional[np.ndarray] = None
        self._visual_feature_video_ids: Optional[List[str]] = None
        self._visual_feature_frame_ids: Optional[List[int]] = None

        # Resource lock for thread safety during loading
        self._resource_lock = threading.RLock()

        # Videos already warned about missing FPS metadata (warn once each)
        self._fps_warned: set = set()

    @staticmethod
    def _configured_device(configured: Optional[str], fallback: torch.device) -> torch.device:
        """Resolve and validate an encoder device inside visible CUDA GPUs."""
        if not configured:
            return fallback
        candidate = torch.device(configured)
        if candidate.type != "cuda":
            return candidate
        if not torch.cuda.is_available():
            raise RuntimeError(f"Configured {configured}, but CUDA is unavailable")
        index = candidate.index if candidate.index is not None else 0
        count = torch.cuda.device_count()
        if index < 0 or index >= count:
            raise ValueError(
                f"Configured CUDA device {configured} is outside the "
                f"CUDA_VISIBLE_DEVICES namespace ({count} visible GPUs)"
            )
        return candidate

    # ????????? Device ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????

    @property
    def device(self) -> torch.device:
        return self._device

    def _resolve_configured_path(
        self, value: Optional[Path]
    ) -> Optional[Path]:
        """Resolve a settings path against the configured data root."""
        if value is None:
            return None
        path = Path(value)
        resolver = getattr(self._settings, "resolve_path", None)
        return Path(resolver(path)) if callable(resolver) else path

    def _load_qdrant_visual_index(
        self, collection: str, dimension: int
    ) -> QdrantVisualIndex:
        """Create one lazy read-only Qdrant visual lane."""
        return QdrantVisualIndex(
            url=self._settings.qdrant_url,
            collection=collection,
            dimension=dimension,
            timeout_seconds=self._settings.qdrant_timeout_seconds,
            vendor_path=self._settings.qdrant_client_vendor,
            exact=self._settings.qdrant_search_exact,
            hnsw_ef=self._settings.qdrant_hnsw_ef,
        )


