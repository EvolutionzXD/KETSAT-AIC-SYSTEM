    def load_bge_m3_encoder(self):
        """Load the BGE-M3 text encoder lazily, for query-side ASR search.

        Raises on failure (matches load_jina_reranker's precedent removed
        2026-08-09 ??? see aic2026-search-algo-tuning memory): this is an
        optional signal, so callers must catch and disable it for the
        request rather than letting the whole search dependency chain fail.
        """
        if self._bge_m3_encoder is None:
            with self._resource_lock:
                if self._bge_m3_encoder is None:
                    from FlagEmbedding import BGEM3FlagModel

                    model_name = self._settings.asr_bge_model_name
                    device = self._settings.asr_bge_device
                    use_fp16 = self._settings.asr_bge_use_fp16
                    logger.info(
                        f"Loading BGE-M3 encoder: {model_name} "
                        f"(device={device}, fp16={use_fp16})"
                    )
                    self._bge_m3_encoder = BGEM3FlagModel(
                        model_name,
                        use_fp16=use_fp16,
                        devices=device,
                    )
                    logger.info(f"BGE-M3 encoder loaded on {device}")
        return self._bge_m3_encoder

    def load_visual_index(self) -> faiss.Index:
        """Load FAISS visual index lazily."""
        if getattr(self._settings, "visual_index_backend", "faiss") == "qdrant":
            if self._visual_index is None:
                self._visual_index = self._load_qdrant_visual_index(
                    self._settings.qdrant_pe_core_collection, 1024
                )
                logger.info(
                    "PE-Core visual lane configured for Qdrant collection %s",
                    self._settings.qdrant_pe_core_collection,
                )
            return self._visual_index
        if self._visual_index is None:
            with self._resource_lock:
                if self._visual_index is None:
                    record = self._active_catalog_index(
                        self._settings.pe_core_index_alias
                    )
                    if record is not None:
                        self._visual_index = self._load_catalog_faiss_index(
                            record,
                            expected_modality="visual_pe_core",
                            expected_model_id=self._settings.pe_core_model_id,
                        )
                        self._frame_ids, _ = self._catalog_frame_contract(record)
                        logger.info(
                            "PE-Core FAISS index loaded from catalog alias %s: %d vectors",
                            self._settings.pe_core_index_alias,
                            self._visual_index.ntotal,
                        )
                    else:
                        path = self._settings.visual_faiss_index_path
                        if not path.exists():
                            logger.warning(
                                f"Visual FAISS index not found at {path}. "
                                "Will use per-video feature search instead."
                            )
                            self._visual_index = None
                        else:
                            logger.info(f"Loading visual FAISS index from {path}")
                            visual_index = faiss.read_index(str(path))
                            self._check_visual_index_metadata(
                                path.parent,
                                visual_index.d,
                                expected_checkpoint=self._settings.pe_core_model_id,
                                expected_encoder_type="pe_core",
                            )
                            self._visual_index = visual_index
                            logger.info(
                                f"PE-Core FAISS index loaded: {visual_index.ntotal} vectors"
                            )
        return self._visual_index

    def load_beit3_visual_index(self) -> Optional[Tuple[faiss.Index, List[str]]]:
        """Load the BEiT-3 visual index and its frame IDs when configured.

        Returning ``None`` makes the main visual path fall back to PE-Core.
        """
        if self._beit3_visual_index is not None:
            return self._beit3_visual_index, self._beit3_frame_ids
        if getattr(self._settings, "visual_index_backend", "faiss") == "qdrant":
            with self._resource_lock:
                if self._beit3_visual_index is None:
                    self._beit3_visual_index = self._load_qdrant_visual_index(
                        self._settings.qdrant_beit3_collection, 1024
                    )
                    self._beit3_frame_ids = []
            return self._beit3_visual_index, self._beit3_frame_ids
        pe_core_record = self._active_catalog_index(
            self._settings.pe_core_index_alias
        )
        if pe_core_record is not None:
            beit3_record = self._active_catalog_index(
                self._settings.beit3_index_alias
            )
            if beit3_record is None:
                logger.warning(
                    "Catalog visual mode is active but alias %s is absent; "
                    "ensemble will use PE-Core only",
                    self._settings.beit3_index_alias,
                )
                return None
            with self._resource_lock:
                if self._beit3_visual_index is None:
                    from src.encoders.beit3_encoder import BEiT3Encoder

                    if (
                        not self._settings.beit3_checkpoint
                        or not self._settings.beit3_lora_checkpoint
                    ):
                        raise ValueError(
                            "BEIT3_CHECKPOINT and BEIT3_LORA_CHECKPOINT must be "
                            "configured before loading the ERM-LoRA index"
                        )
                    expected_checkpoint = BEiT3Encoder.checkpoint_identity(
                        model_name=self._settings.beit3_model_name,
