    def load_asr_bge_fine_segments(self) -> List[Dict]:
        """Load the optional sentence-level ASR sidecar."""
        if self._asr_bge_fine_segments is None:
            path = getattr(self._settings, "asr_bge_fine_segments_path", None)
            if path is None or not path.exists():
                self._asr_bge_fine_segments = []
            else:
                with open(path, "r", encoding="utf-8") as f:
                    value = json.load(f)
                self._asr_bge_fine_segments = value if isinstance(value, list) else []
                logger.info(
