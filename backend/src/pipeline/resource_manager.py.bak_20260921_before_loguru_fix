    def load_ocr_frame_map(self):
        """Load every configured OCR frame-map shard exactly once.

        A configured-but-missing shard is an installation error. Silently
        dropping it makes inherited frames disappear while leaving the service
        looking healthy, so the complete configured set is validated before
        any shard is parsed.
        """
        if getattr(self, "_ocr_frame_map", None) is None:
            with self._resource_lock:
                if getattr(self, "_ocr_frame_map", None) is None:
                    configured = list(
                        self._settings.ocr_frame_map_paths or []
                    )
                    if not configured:
                        self._ocr_frame_map = False
                        logger.info(
                            "OCR frame map not configured -- "
                            "inherited-frame expansion disabled"
                        )
                    else:
                        paths = [
                            self._resolve_configured_path(path)
                            for path in configured
                        ]
                        missing = [
                            str(path)
                            for path in paths
                            if path is None or not path.is_file()
                        ]
                        if missing:
                            raise FileNotFoundError(
                                "Configured OCR frame-map shard(s) missing: "
                                + ", ".join(missing)
                            )
                        from src.search.ocr_frame_map import load_frame_map

                        self._ocr_frame_map = load_frame_map(paths)
        return self._ocr_frame_map or None

    @staticmethod
    def _validate_ocr_semantic_metadata(
        metadata: object, expected_rows: int
    ) -> List[Dict]:
        """Validate the row contract shared by the index and sidecar."""
        if not isinstance(metadata, list):
            raise ValueError("OCR semantic metadata must be a JSON list")
        if len(metadata) != int(expected_rows):
            raise ValueError(
                "OCR semantic index/metadata row mismatch: "
                f"{expected_rows} != {len(metadata)}"
            )

        for row_index, row in enumerate(metadata):
            if not isinstance(row, dict):
                raise ValueError(
                    f"OCR semantic metadata row {row_index} is not an object"
                )
            try:
                embedding_row = int(row.get("embedding_row", row_index))
            except (TypeError, ValueError) as exc:
                raise ValueError(
                    f"OCR semantic metadata row {row_index} has an invalid "
                    "embedding_row"
                ) from exc
            if embedding_row != row_index:
                raise ValueError(
                    f"OCR semantic metadata row {row_index} is mapped to "
                    f"embedding row {embedding_row}"
                )

            evidence_id = row.get("evidence_id") or row.get("dense_text_id")
            if not isinstance(evidence_id, str) or not evidence_id.strip():
                raise ValueError(
                    f"OCR semantic metadata row {row_index} has no evidence_id"
                )
            if not isinstance(row.get("text"), str):
                raise ValueError(
                    f"OCR semantic metadata row {row_index} has invalid text"
                )
            occurrences = row.get("occurrences")
            if not isinstance(occurrences, list):
                raise ValueError(
                    f"OCR semantic metadata row {row_index} has invalid "
                    "occurrences"
                )
            for occurrence_index, occurrence in enumerate(occurrences):
                if not isinstance(occurrence, dict):
                    raise ValueError(
                        f"OCR semantic metadata row {row_index}, occurrence "
                        f"{occurrence_index} is not an object"
                    )
                video_id = occurrence.get("video_id")
                if not isinstance(video_id, str) or not video_id.strip():
                    raise ValueError(
                        f"OCR semantic metadata row {row_index}, occurrence "
                        f"{occurrence_index} has no video_id"
                    )
                frame_value = occurrence.get("frame_id")
                if isinstance(frame_value, bool):
                    raise ValueError(
                        f"OCR semantic metadata row {row_index}, occurrence "
                        f"{occurrence_index} has an invalid frame_id"
                    )
                try:
                    frame_id = int(frame_value)
                except (TypeError, ValueError) as exc:
                    raise ValueError(
                        f"OCR semantic metadata row {row_index}, occurrence "
                        f"{occurrence_index} has an invalid frame_id"
                    ) from exc
                if frame_id < 0:
                    raise ValueError(
                        f"OCR semantic metadata row {row_index}, occurrence "
                        f"{occurrence_index} has a negative frame_id"
                    )
                confidence = occurrence.get("confidence")
                if confidence is not None:
                    if isinstance(confidence, bool):
                        raise ValueError(
                            f"OCR semantic metadata row {row_index}, occurrence "
                            f"{occurrence_index} has an invalid confidence"
                        )
                    try:
                        confidence_value = float(confidence)
                    except (TypeError, ValueError) as exc:
                        raise ValueError(
                            f"OCR semantic metadata row {row_index}, occurrence "
                            f"{occurrence_index} has an invalid confidence"
                        ) from exc
                    if not math.isfinite(confidence_value) or not (
                        0.0 <= confidence_value <= 1.0
                    ):
                        raise ValueError(
                            f"OCR semantic metadata row {row_index}, occurrence "
                            f"{occurrence_index} has an invalid confidence"
                        )
        return metadata

    def load_ocr_semantic_index(
        self,
    ) -> Optional[Tuple[faiss.Index, List[Dict]]]:
        """Load the row-safe OCR BGE-M3 index and its sidecar."""
        if self._ocr_semantic_load_attempted:
            if self._ocr_semantic_index is None:
                return None
            return self._ocr_semantic_index, self._ocr_semantic_metadata or []

        with self._resource_lock:
            if self._ocr_semantic_load_attempted:
                if self._ocr_semantic_index is None:
                    return None
                return (
                    self._ocr_semantic_index,
                    self._ocr_semantic_metadata or [],
                )

            index_value = getattr(
                self._settings, "ocr_semantic_index_path", None
            )
            metadata_value = getattr(
                self._settings, "ocr_semantic_metadata_path", None
            )
            if index_value is None and metadata_value is None:
                self._ocr_semantic_load_attempted = True
                logger.info(
                    "OCR semantic index not configured -- "
                    "semantic OCR disabled"
                )
                return None
            if index_value is None or metadata_value is None:
                raise ValueError(
                    "OCR semantic index and metadata paths must be configured "
                    "together"
                )

            index_path = self._resolve_configured_path(index_value)
            metadata_path = self._resolve_configured_path(metadata_value)
            missing = [
                str(path)
                for path in (index_path, metadata_path)
                if path is None or not path.is_file()
            ]
            if missing:
                raise FileNotFoundError(
                    "Configured OCR semantic artifact(s) missing: "
                    + ", ".join(missing)
                )

            logger.info(
                f"Loading OCR semantic FAISS index from {index_path}"
            )
            index = faiss.read_index(str(index_path))
            with metadata_path.open("r", encoding="utf-8") as handle:
                metadata = json.load(handle)
            validated = self._validate_ocr_semantic_metadata(
                metadata, int(index.ntotal)
            )
            self._ocr_semantic_index = index
            self._ocr_semantic_metadata = validated
            self._ocr_semantic_load_attempted = True
            logger.info(
                "OCR semantic index loaded: "
                f"{index.ntotal} rows, dim={index.d}, "
                f"{len(validated)} metadata rows"
            )
            return index, validated
    def load_caption_results(self) -> Dict:
        """Load Qwen semantic records (KCP-window captions) lazily.

        Records with ``record: null`` (unparseable/unrepairable JSON, ~0.1%
        of the real corpus) are left in the dict as-is ??? search_caption_records
        skips them rather than this loader filtering them, so a caller that
        wants the raw text for auditing still can.
        """
        if self._caption_results is None:
            path_qwen = self._settings.qwen_semantic_records_path
            if path_qwen and path_qwen.exists():
                with open(path_qwen, "r", encoding="utf-8") as f:
                    self._caption_results = json.load(f)
                logger.info(f"Qwen semantic records loaded: {len(self._caption_results)} entries")
            else:
                self._caption_results = {}
                logger.info("No Qwen semantic records found ??? caption search disabled")
        return self._caption_results

    def load_qwen_structured_indexes(self) -> Dict:
        """Load field-aware Qwen FAISS indexes and their row sidecars."""
        if self._qwen_structured_indexes is None:
            with self._resource_lock:
                if self._qwen_structured_indexes is None:
                    root = self._settings.qwen_structured_index_dir
                    loaded = {}
                    if root and Path(root).is_dir():
                        for field in ("visual_description", "actions", "entities"):
                            index_path = Path(root) / f"{field}.faiss"
                            rows_path = Path(root) / f"{field}.json"
                            if not index_path.exists() or not rows_path.exists():
                                continue
                            index = faiss.read_index(str(index_path))
                            with open(rows_path, "r", encoding="utf-8") as handle:
                                rows = json.load(handle)
                            if index.ntotal != len(rows):
                                raise ValueError(
                                    f"Qwen {field} index/sidecar mismatch: "
                                    f"{index.ntotal} vectors vs {len(rows)} rows"
                                )
                            loaded[field] = (index, rows)
                    self._qwen_structured_indexes = loaded
                    logger.info(
                        "Qwen structured indexes loaded: {}",
                        {name: index.ntotal for name, (index, _) in loaded.items()},
                    )
        return self._qwen_structured_indexes

    def load_scene_graph(self) -> Dict:
        """Load scene graph triplets lazily."""
        if self._scene_graph is None:
            path = self._settings.scene_graph_path
            if path and path.exists():
                with open(path, "r", encoding="utf-8") as f:
                    self._scene_graph = json.load(f)
                logger.info(
                    f"Scene graph loaded: {len(self._scene_graph)} entries"
                )
            else:
                self._scene_graph = {}
                logger.info("No scene graph found ??? graph search disabled")
        return self._scene_graph

    # ????????? Visual Features (per-video .npy files) ???????????????????????????????????????????????????????????????????????????????????????

    def load_visual_features_for_video(
        self, video_id: str
    ) -> Tuple[np.ndarray, List[int]]:
        """
        Load all .npy visual features for a single video.

        Returns:
            features: (N, D) numpy array of feature vectors
            frame_ids: list of frame IDs corresponding to each row
        """
        if self._visual_features is None:
            self._visual_features = {}

        if video_id not in self._visual_features:
            feat_dir = self._settings.features_dir / video_id
            features, frame_ids = [], []
            if feat_dir.exists():
                for f in sorted(feat_dir.glob("*.npy")):
                    try:
                        feat = np.load(f)
                        if feat.ndim == 1:
                            feat = feat.reshape(1, -1)
                        frame_id = int(f.stem)
                        features.append(feat)
                        frame_ids.append(frame_id)
                    except Exception as e:
                        logger.warning(f"Failed to load {f}: {e}")
            self._visual_features[video_id] = (
                np.vstack(features) if features else np.array([]),
                frame_ids,
            )
        return self._visual_features[video_id]

    # ????????? Convenience: Preload All ???????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????

    def preload_all(self) -> None:
        """Eagerly load all resources at startup. Call once at app start."""
        logger.info("Preloading all resources...")
        loaders = [
            ("catalog", self.load_catalog),
            ("pe_core_encoder", self.load_pe_core_encoder),
            ("audio_index", self.load_audio_index),
            ("visual_index", self.load_visual_index),
            ("beit3_visual_index", self.load_beit3_visual_index),
            ("beit3_encoder", self.load_beit3_encoder),
            ("siglip2_visual_index", self.load_siglip2_visual_index),
            ("siglip2_encoder", self.load_siglip2_encoder),
            ("asr_bge_index", self.load_asr_bge_index),
            ("asr_bge_segments", self.load_asr_bge_segments),
            ("bge_m3_encoder", self.load_bge_m3_encoder),
            ("audio_metadata", self.load_audio_metadata),
            ("frame_ids", self.load_frame_ids),
            ("frame_mapping", self.load_frame_mapping),
            ("video_metadata", self.load_video_metadata),
            ("ocr_results", self.load_ocr_results),
            ("ocr_frame_map", self.load_ocr_frame_map),
            ("ocr_semantic_index", self.load_ocr_semantic_index),
            ("caption_results", self.load_caption_results),
            ("qwen_structured_indexes", self.load_qwen_structured_indexes),
            ("scene_graph", self.load_scene_graph),
        ]
        if getattr(self._settings, "asr_bge_prefer_fine", False):
            loaders.extend(
                [
                    ("asr_bge_fine_index", self.load_asr_bge_fine_index),
                    ("asr_bge_fine_segments", self.load_asr_bge_fine_segments),
                ]
            )
        if getattr(self._settings, "jina_v5_enabled", False):
            loaders.extend(
                [
                    ("jina_v5_visual_index", self.load_jina_v5_visual_index),
                    ("jina_v5_encoder", self.load_jina_v5_encoder),
                ]
            )
        failed = []
        for name, loader in loaders:
            try:
                loader()
            except Exception as exc:
                failed.append(name)
                logger.warning(f"Preload warning ({name}): {exc}")

        if self._settings.preload_visual_features:
            try:
                self._preload_all_visual_features()
            except Exception as exc:
                failed.append("visual_features")
                logger.warning(f"Preload warning (visual_features): {exc}")

        if failed:
            failed_str = ", ".join(failed)
            logger.warning(f"Preload completed with unavailable resources: {failed_str}")
        else:
            logger.info("All resources preloaded successfully")

    def _preload_all_visual_features(self) -> None:
        """Preload all visual features into memory (requires ~10GB for large datasets)."""
        features_dir = self._settings.features_dir
        if not features_dir.exists():
            return
        for video_id in os.listdir(features_dir):
            self.load_visual_features_for_video(video_id)
        logger.info(f"Preloaded visual features for {len(self._visual_features)} videos")

