# Final_AIC runtime defaults for the existing Batch1 artifacts.
# Copy this file to backend/.env or point FINAL_AIC_ENV_FILE at a private file.
# Never commit or paste the Typesense key into this example.

HOST=0.0.0.0
PORT=8602
API_WORKERS=1
LOG_LEVEL=INFO
STARTUP_WARMUP_ENABLED=false
DEVICE=cpu

DATA_ROOT=/home/bachdx/Final_AIC/data
FRAME_MAPPING_PATH=/home/bachdx/Final_AIC/data/runtime/frame_mapping.json
VIDEO_METADATA_PATH=/home/bachdx/Final_AIC/data/runtime/video_metadata.json
RRF_KCP_SEGMENTS_PATH=/home/bachdx/Final_AIC/data/runtime/event_segments_p25.json
RRF_KCP_ENABLED=true

# Visual retrieval: read-only Qdrant.  The adapter accepts both the current
# unnamed Batch1 vector and the named ``embedding`` vector used by new builds.
VISUAL_INDEX_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:16333
QDRANT_CLIENT_VENDOR=/home/bachdx/Final_AIC/backend/vendor/python
QDRANT_CLIENT_VENDOR_PATH=/home/bachdx/Final_AIC/backend/vendor/python
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PE_CORE_COLLECTION=aic_batch1_reduce_pe_core
QDRANT_BEIT3_COLLECTION=aic_batch1_reduce_beit3
QDRANT_SIGLIP2_COLLECTION=aic_batch1_reduce_siglip2
QDRANT_JINA_V5_COLLECTION=aic_batch1_reduce_jina_v5
ENSEMBLE_ENABLED=true
JINA_V5_ENABLED=true
PRELOAD_VISUAL_FEATURES=false
BEIT3_CHECKPOINT=/home/bachdx/Final_AIC/models/beit3/beit3_large_itc_patch16_224.pth
BEIT3_LORA_CHECKPOINT=/home/bachdx/Final_AIC/models/beit3/beit3_erm_lora_best.pt
BEIT3_SPM_PATH=/home/bachdx/Final_AIC/models/beit3/beit3.spm

# Text retrieval: read-only Typesense.  Supply the key through a private env
# file or the existing Final_AIC/database/typesense/typesense.env.
TEXT_INDEX_BACKEND=typesense
TYPESENSE_ASR_ENABLED=false
TYPESENSE_OCR_ENABLED=false
TYPESENSE_CAPTION_ENABLED=false
TYPESENSE_URL=http://127.0.0.1:8108
# TYPESENSE_API_KEY=private-key-here
TYPESENSE_TIMEOUT_SECONDS=15
TYPESENSE_VECTOR_EF=100
TYPESENSE_OCR_COLLECTION=ocr_frames_current
TYPESENSE_ASR_COLLECTION=asr_segments_current
TYPESENSE_ASR_FINE_COLLECTION=asr_segments_fine_native_v2
TYPESENSE_ASR_EF=4096
TYPESENSE_CAPTION_COLLECTION=caption_windows_current
TYPESENSE_OCR_MODE=hybrid
TYPESENSE_ASR_MODE=semantic
TYPESENSE_CAPTION_MODE=hybrid
TYPESENSE_ASR_GRANULARITY=sentence
ASR_BGE_PREFER_FINE=true
ASR_BGE_DEVICE=cpu

HF_HOME=/home/bachdx/Final_AIC/models/huggingface
HUGGINGFACE_HUB_CACHE=/home/bachdx/Final_AIC/models/huggingface/hub
TRANSFORMERS_CACHE=/home/bachdx/Final_AIC/models/huggingface/hub

# Keep optional legacy local lanes disabled/unconfigured in Final_AIC.
# They remain in the copied source for compatibility and ablation only.
